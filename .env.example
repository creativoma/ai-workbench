# LLM provider (server-side only — never exposed to the frontend)
# One key is enough. With no AI_PROVIDER set, the first provider whose key is
# present wins — Anthropic first. Delete the line you are not using.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Forces the choice regardless of which keys are set: anthropic | google
# Google is the one with a free tier — https://aistudio.google.com/apikey
AI_PROVIDER=google

# Overrides that provider's default model (claude-opus-5 / gemini-3.6-flash)
# AI_MODEL=gemini-flash-latest

# Phase 5 — observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com